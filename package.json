{
  "name": "mautic-kit",
  "version": "0.5.0",
  "description": "Install and configure a self-hosted Mautic (the console steps), plus the CUE schema for declarations. Zero dependencies.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mautic-kit": "./bin/mautic-kit.mjs"
