{
  "name": "mautic-kit",
  "version": "0.2.10",
  "description": "Install, configure and provision Mautic from per-brand declarations. Zero dependencies.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mautic-kit": "./bin/mautic-kit.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "default": "./src/index.mjs"
    },
    "./types": {
      "types": "./src/types.d.mts"
    },
    "./html": "./src/html.mjs",
    "./tokens": "./src/tokens.mjs"
  },
  "files": [
    "bin",
    "src",
    "cue/schema"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
